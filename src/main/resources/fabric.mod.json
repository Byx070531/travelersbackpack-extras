{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "issues": "${mod_issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": ["com.tbupgrades.extras.client.TbxModMenu"],
    "main": [
      "com.tbupgrades.extras.TravelersBackpackExtras"
    ],
    "client": [
      "com.tbupgrades.extras.TravelersBackpackExtrasClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.client.mixins.json",
    "${mod_id}.ipn.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": ">=0.140.0",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "travelersbackpack": ">=10.11.11",
    "advancednetherite": "*"
  }
}
